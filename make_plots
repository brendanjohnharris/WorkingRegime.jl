#! /bin/bash

# Runs every figure script, in figure order. Prior to this script, EITHER:
#     1. download WorkingRegime_data.zip from https://doi.org/10.6084/m9.figshare.34021314 and unzip it at the repository root (see README.md), OR:
#     2. run the calculation scripts in the order given under "Producing the data" in README.md.

PROJECT_DIR="$(dirname "$(realpath "$0")")"

bash "$PROJECT_DIR/scripts/Fig1_combined_curves.jl"
bash "$PROJECT_DIR/scripts/Fig2_bFNS.jl"
bash "$PROJECT_DIR/scripts/Fig3_effective_theory.jl"
bash "$PROJECT_DIR/scripts/Fig4_hierarchical_variation.jl"
bash "$PROJECT_DIR/scripts/FigS1_visual_coding.jl"
bash "$PROJECT_DIR/scripts/FigS23_summaries.jl"
bash "$PROJECT_DIR/scripts/FigS4_input_parameters.jl"
bash "$PROJECT_DIR/scripts/VideoS1_input_field.jl"
